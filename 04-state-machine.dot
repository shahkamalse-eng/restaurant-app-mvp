digraph G {rankdir=LR; node[shape=circle]; Start[label="start"]; End[label="end"]; Pending[shape=box]; Preparing[shape=box]; Ready[shape=box]; Served[shape=box]; Cancelled[shape=box]; Start->Pending[label="place order"];Pending->Preparing[label="10s / manager"];Preparing->Ready[label="20s / manager"];Ready->Served[label="30s / manager"];Pending->Cancelled[label="cancel"];Preparing->Cancelled[label="cancel"];Served->End;Cancelled->End;}